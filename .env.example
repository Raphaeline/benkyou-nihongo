# Salin file ini menjadi .env.local lalu isi nilainya sendiri.
# .env.local tidak ikut di-commit (lihat .gitignore).

# URL situs untuk redirect auth. Lokal: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings > API Keys. Publishable key aman di browser (dilindungi RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...) melewati RLS. Hanya untuk script seed lokal.
# Di CI disimpan di GitHub Environments, tidak pernah di Vercel.
SUPABASE_SECRET_KEY=
