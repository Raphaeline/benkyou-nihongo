{
  "name": "benkyou-nihongo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:db": "node scripts/test-db.mjs",
    "preview:draft": "node scripts/preview-draft.mjs",
    "test": "node --test \"tests/**/*.test.ts\"",
    "validate:content": "node scripts/validate-content.ts",
    "seed:content": "node --env-file-if-exists=.env.local scripts/seed-content.ts",
    "seed:content:prod": "node --env-file=.env.prod scripts/seed-content.ts --publish=reviewed"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "marked": "16.4.2",
    "supabase": "2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
